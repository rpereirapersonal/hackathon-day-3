# Placeholders only. Export real credentials in the shell; never commit them.
# (NFR-6.1, NFR-6.2, CON-6 — a secret scan over the tracked tree is AC-10.)

# --- Reasoning brain: the supplied Qwen agent-brain (BLK-3) ---
AGENT_BRAIN_MODEL=agent-brain
AGENT_BRAIN_BASE_URL=http://<litellm-gateway-host>:4000/v1
# AGENT_BRAIN_API_KEY  -> shell only

# --- Domain synthesis: the team's fine-tuned Nemotron (BLK-4) ---
# The run2 LoRA adapter over Llama-3.1-Nemotron-Nano-8B-v1, served as its own
# OpenAI-compatible endpoint. DOMAIN_FT_MODEL must match the alias the serving
# stack registers the adapter under, not the base model's name — pointing this
# at the base model silently forfeits the fine-tuned-model evidence (AC-12).
DOMAIN_FT_MODEL=nemotron-finance-lora
DOMAIN_FT_BASE_URL=http://<adapter-host>:8001/v1
# DOMAIN_FT_API_KEY    -> shell only

# `mock` for pre-adapter integration testing, `llm` for real inference.
# MUST be switched to `llm` before official evaluation, or the submission does
# not use the fine-tuned model at all (brief §3, FR-5.5, AC-12).
DOMAIN_PREDICT_MODE=mock

# --- Budgets ---
# 50s internal target leaves headroom inside the 60s full-points band.
REQUEST_DEADLINE_SECONDS=50
# Backstop, not the target: the prompt aims at <=3 calls, but MHQ080-style
# questions need article + cash rate + basket return, so a cap of 3 leaves no
# room for the one adaptive retry after a failed call.
MAX_TOOL_CALLS=5

# --- Data layer ---
# SOURCE_DATA_DIR holds the supplied datasets and is never written to (CON-3).
# DATA_DIR holds the artifacts built by `python -m src.ingest`, ~1.9 GB.
SOURCE_DATA_DIR=./data set
DATA_DIR=./data
# 384-dim model: 219,538 vectors is ~337 MB, and it encodes materially faster
# than the base model on the aarch64 host, where ingest is a one-off but still
# has to finish.
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=./.cache/fastembed

LOG_DIR=./logs
