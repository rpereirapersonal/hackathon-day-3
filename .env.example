# Placeholders only. Export real credentials in the shell; never commit them.
# (NFR-6.1, NFR-6.2, CON-6 — a secret scan over the tracked tree is AC-10.)

# --- Reasoning brain: the supplied Qwen agent-brain (BLK-3) ---
AGENT_BRAIN_MODEL=agent-brain
AGENT_BRAIN_BASE_URL=http://<litellm-gateway-host>:4000/v1
# AGENT_BRAIN_API_KEY  -> shell only

# --- Domain synthesis: the team's fine-tuned Nemotron (BLK-4) ---
DOMAIN_FT_MODEL=<fine-tuned-nemotron-alias>
DOMAIN_FT_BASE_URL=http://<adapter-host>:8001/v1
# DOMAIN_FT_API_KEY    -> shell only

# `mock` for pre-adapter integration testing, `llm` for real inference.
# MUST be switched to `llm` before official evaluation, or the submission does
# not use the fine-tuned model at all (brief §3, FR-5.5, AC-12).
DOMAIN_PREDICT_MODE=mock

# --- Budgets ---
# 50s internal target leaves headroom inside the 60s full-points band.
REQUEST_DEADLINE_SECONDS=50
MAX_TOOL_CALLS=3

# --- Data layer (BLK-2: paths provisional until the datasets arrive) ---
DATA_DIR=./data
DB_PATH=./data/market.db
INDEX_PATH=./data/afr.index
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
EMBEDDING_CACHE_DIR=./.cache/fastembed

LOG_DIR=./logs
